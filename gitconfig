[github]
  user = thommay
  token = FOO
[user]
	name = Thom May
	email = thom@may.yt
[hub]
	http-clone = true
	protocol = https
[credential]
	helper = osxkeychain
	UseHttpPath = true
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[push]
	default = current
[core]
	excludesfile = /Users/thom/.gitignore_global
	autocrlf = input
	editor = hx
	fsmonitor = true
    pager = delta
[interactive]
   diffFilter = delta --color-only
[url "https://github.com/"]
	insteadOf = git://github.com/
[diff]
	algorithm = patience
  compactionHeuristic = true
  colorMoved = default
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autostash = true
	autosquash = true
	updateRefs = true
  
[commit]
	gpgsign = true
[alias]
  st = status -sb
  ci = commit
  cm = commit -m
  ca = commit -av
  co = checkout
  cb = "!f() { gh=$(git head);git fetch origin; git checkout -b $1 ${2:-$gh}; }; f"
  ;clean = "!f() {  git branch --merged|egrep -v '(^\*|master|develop|main)' | xargs git branch -d; }; f"
  lp = log -p
  amend = commit --amend --no-edit
  ai = add -p
  ap = ai
  hist = log --all --graph --pretty='[%C(cyan)%h%Creset]%C(bold cyan)%d%Creset %s'
  p = pull --prune
  pu = push -u
  pf = push --force-with-lease
  pur = "!gh pr create"
  get-pr = "!gh get pr"
  head =  rev-parse --abbrev-ref origin/HEAD 
  fix = commit --no-gpg-sign --fixup
  fu = checkout -f
  save = commit -a --no-gpg-sign -m 'save game'
  squash = "!f() { gh=$(git head);git fetch; git rebase -i --autosquash ${1:-$gh}; }; f"
  stashq = -c commit.gpgsign=false stash
  aliases = "!git config -l |grep alias| cut -c 7-"
  new-tree = "!f() { gh=$(git head);git fetch; git worktree add -b $1 $2 ${3:-$gh}; }; f"
  fork = "!gh repo fork"
  create = "!gh repo create"
  branches = "!git for-each-ref --sort='-authordate' --format='%(authordate)%09%(objectname:short)%09%(refname)' refs/heads | sed -e 's-refs/heads/--'"
[fetch]
	prune = true
[pull]
	rebase = true
[merge]
  conflictstyle = zdiff3
  renamelimit = 6000
[pack]
	useSparse = true
[init]
	; templateDir = /Users/thommay/.config/git
  defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[delta]
#  syntax-theme = Monokai Extended Origin
  navigate = true
[gpg "x509"]
	program = /usr/local/bin/ac-sign
[gpg]
	format = x509
[branch]
	sort = -committerdate
[column]
	ui = auto
[credential "https://dev.azure.com"]
	useHttpPath = true
